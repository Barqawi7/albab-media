# BAB Dashboard env vars — copy to .env.local and fill in.

# Supabase (required) — anon key only; server-side admin tasks happen in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=https://dvklqmoddcqbisnbknsj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail room (optional). Add <origin>/api/auth/callback to the Google OAuth redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AI Assistant (optional). Calls Anthropic Messages API server-side.
ANTHROPIC_API_KEY=
